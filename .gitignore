# Credentials. NEVER commit these — an API key is often a billing credential.
.env.local
.env
*.pem
*.key

# Quarantined responses are triage material — they live in CI artifacts for
# 90 days, never in git. Bad bytes must not enter the archive.
quarantine/

__pycache__/
*.pyc
.venv/

# Raw captures. This repo's only source declares `storage: object` -- one
# capture is 23.8 MB of already-compressed zip, so git would carry 286 MB a
# year. A local `wss capture` still writes here when R2 is unconfigured, and
# committing that by accident is exactly the mistake this line prevents.
raw/wdpa.protected.areas/
